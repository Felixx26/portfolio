---
import { getCollection } from 'astro:content';
import { contact, education, experience, skills, t, type Lang } from '../i18n/profile';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf(),
);

const years = new Date().getFullYear() - 2020;
const skillKeys = Object.keys(skills) as (keyof typeof skills)[];
---

<div class="wrap">
  <section class="hero">
    <p class="eyebrow"><span class="dot"></span>{s.available}</p>
    <h1>{contact.shortName}<span class="role">{s.role}</span></h1>
    <p class="tagline">{s.tagline}</p>
    <div class="actions">
      <a class="btn primary" href="#projects">{s.ctaProjects} →</a>
      <a class="btn" href="#contact">{s.ctaContact}</a>
    </div>
    <dl class="stats">
      <div><dt>{years}+</dt><dd>{s.yearsLabel}</dd></div>
      <div><dt>JS · TS · Java</dt><dd>{s.skillGroups.languages}</dd></div>
      <div><dt>{contact.location.split(',')[0]}, FL</dt><dd>{s.remote}</dd></div>
    </dl>
  </section>

  <section id="about">
    <div class="section-head"><span class="num">01</span><h2>{s.aboutTitle}</h2></div>
    <div class="about-grid">
      <div class="prose">{s.about.map((p) => <p>{p}</p>)}</div>
      <div class="skills">
        <p class="eyebrow">{s.skillsTitle}</p>
        {skillKeys.map((k) => (
          <div class="skill-group">
            <h3>{s.skillGroups[k]}</h3>
            <div class="tags">{skills[k].map((x) => <span class="tag">{x}</span>)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="experience">
    <div class="section-head"><span class="num">02</span><h2>{s.experienceTitle}</h2></div>
    <ol class="timeline">
      {experience.map((job) => (
        <li>
          <div class="when">
            {job.start[lang]} — {job.end ? job.end[lang] : s.present}
            <span>{s.remote}</span>
          </div>
          <div class="what">
            <h3>{job.role[lang]} <span class="at">@ {job.company}</span></h3>
            <ul>{job.points[lang].map((p) => <li>{p}</li>)}</ul>
            <div class="tags">{job.tags.map((x) => <span class="tag">{x}</span>)}</div>
          </div>
        </li>
      ))}
    </ol>
    <div class="extra">
      <div>
        <p class="eyebrow">{s.educationTitle}</p>
        <p>{education.school}<br /><span class="muted">{education.years}</span></p>
      </div>
      <div>
        <p class="eyebrow">{s.languagesTitle}</p>
        <p>{s.spokenLanguages.map((l) => <>{l}<br /></>)}</p>
      </div>
    </div>
  </section>

  <section id="projects">
    <div class="section-head"><span class="num">03</span><h2>{s.projectsTitle}</h2></div>
    {projects.length === 0 ? (
      <div class="empty">
        <span class="mono">// TODO</span>
        <p>{s.projectsEmpty}</p>
      </div>
    ) : (
      <div class="grid">
        {projects.map(({ data }) => (
          <article class="card">
            <div class="card-top">
              <span class={`status ${data.status}`}>{s.status[data.status]}</span>
              <span class="mono muted">{data.date.getFullYear()}</span>
            </div>
            <h3>{data.title}</h3>
            <p>{lang === 'en' ? data.summary_en : data.summary_es}</p>
            <div class="tags">{data.stack.map((x) => <span class="tag">{x}</span>)}</div>
            <div class="links">
              {data.repo && <a href={data.repo} target="_blank" rel="noopener">{s.code} ↗</a>}
              {data.demo && <a href={data.demo} target="_blank" rel="noopener">{s.demo} ↗</a>}
            </div>
          </article>
        ))}
      </div>
    )}
  </section>

  <section id="contact" class="contact">
    <div class="section-head"><span class="num">04</span><h2>{s.contactTitle}</h2></div>
    <p class="tagline">{s.contactText}</p>
    <a class="mail" href={`mailto:${contact.email}`}>{contact.email}</a>
    <div class="actions">
      <a class="btn" href={contact.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
      {contact.github && <a class="btn" href={contact.github} target="_blank" rel="noopener">GitHub ↗</a>}
    </div>
  </section>
</div>

<style>
  .hero { border-top: 0; padding: 112px 0 96px; }
  .hero .eyebrow { display: flex; align-items: center; gap: 10px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 25%, transparent); }
  h1 { font: 400 clamp(48px, 9vw, 104px)/0.95 var(--serif); letter-spacing: -.03em; margin: 28px 0 28px; }
  h1 .role { display: block; font: 400 clamp(18px, 2.4vw, 24px)/1.3 var(--sans); letter-spacing: 0; color: var(--muted); margin-top: 18px; }
  .tagline { font-size: clamp(17px, 2vw, 20px); max-width: 640px; color: var(--text); }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 72px; padding-top: 28px; border-top: 1px dashed var(--line); }
  .stats dt { font: 500 20px var(--mono); }
  .stats dd { font-size: 13px; color: var(--muted); margin-top: 4px; }
  @media (max-width: 640px) { .stats { grid-template-columns: 1fr; gap: 16px; } }

  .about-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 56px; }
  .prose p + p { margin-top: 16px; }
  .prose p { color: var(--muted); font-size: 17px; }
  .prose p:first-child { color: var(--text); }
  .skills { display: flex; flex-direction: column; gap: 20px; }
  .skill-group h3 { font: 500 14px var(--sans); margin-bottom: 8px; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  @media (max-width: 820px) { .about-grid { grid-template-columns: 1fr; gap: 40px; } }

  .timeline { list-style: none; }
  .timeline > li { display: grid; grid-template-columns: 200px 1fr; gap: 32px; padding: 28px 0; border-bottom: 1px solid var(--line); }
  .timeline > li:first-child { padding-top: 0; }
  .when { font: 13px/1.6 var(--mono); color: var(--muted); }
  .when span { display: block; opacity: .7; }
  .what h3 { font: 500 19px var(--sans); margin-bottom: 12px; }
  .at { color: var(--accent); font-weight: 400; }
  .what ul { padding-left: 18px; color: var(--muted); margin-bottom: 16px; }
  .what li + li { margin-top: 6px; }
  @media (max-width: 720px) { .timeline > li { grid-template-columns: 1fr; gap: 8px; } }
  .extra { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-top: 40px; }
  .extra .eyebrow { margin-bottom: 10px; }
  .muted { color: var(--muted); }
  @media (max-width: 560px) { .extra { grid-template-columns: 1fr; } }

  .empty { border: 1px dashed var(--line); border-radius: 10px; padding: 48px 28px; text-align: center; color: var(--muted); }
  .mono { font-family: var(--mono); font-size: 13px; }
  .empty .mono { color: var(--accent); display: block; margin-bottom: 10px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 24px; display: flex; flex-direction: column; gap: 14px; transition: border-color .15s; }
  .card:hover { border-color: var(--accent); }
  .card-top { display: flex; justify-content: space-between; align-items: center; }
  .card h3 { font: 500 22px var(--serif); }
  .card p { color: var(--muted); font-size: 15px; flex: 1; }
  .status { font: 11px var(--mono); text-transform: uppercase; letter-spacing: .08em; }
  .status.live { color: var(--accent); }
  .links { display: flex; gap: 16px; font: 13px var(--mono); }
  .links a { text-decoration: none; }
  .links a:hover { color: var(--accent); }

  .contact .mail { display: inline-block; margin-top: 20px; font: 400 clamp(22px, 4vw, 40px) var(--serif); text-decoration-color: var(--accent); text-underline-offset: 6px; word-break: break-all; }
</style>
