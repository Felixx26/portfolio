---
import '../styles/global.css';
import { contact, t, type Lang } from '../i18n/profile';
import SpeedInsights from "@vercel/speed-insights/astro"

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const title = `${contact.shortName} — ${s.role}`;
const altHref = lang === 'en' ? '/es/' : '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={s.tagline} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL('/es/', Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={s.tagline} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      function speedInsightsBeforeSend(data){
        console.log("Speed Insights before send", data)
        return data;
      }
    </script>
    <SpeedInsights />
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="logo" href={lang === 'en' ? '/' : '/es/'}>fg<span>.</span></a>
        <nav aria-label="Main">
          <a href="#about">{s.navAbout}</a>
          <a href="#experience">{s.navExperience}</a>
          <a href="#projects">{s.navProjects}</a>
          <a href="#contact">{s.navContact}</a>
          <a class="lang" href={altHref} hreflang={lang === 'en' ? 'es' : 'en'}>{s.switchLang}</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="wrap foot">
      <span>© {new Date().getFullYear()} {contact.name}</span>
      <span>{s.footer}</span>
    </footer>
  </body>
</html>

<style>
  .nav {
    position: sticky; top: 0; z-index: 10;
    backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 60px; }
  .logo { font: 500 22px var(--serif); text-decoration: none; }
  .logo span { color: var(--accent); }
  nav { display: flex; gap: 22px; font-size: 14px; }
  nav a { text-decoration: none; color: var(--muted); transition: color .15s; }
  nav a:hover { color: var(--text); }
  .lang { font-family: var(--mono); font-size: 12px; border: 1px solid var(--line); padding: 4px 8px; border-radius: 4px; }
  @media (max-width: 640px) {
    nav a:not(.lang) { display: none; }
  }
  .foot {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px;
    padding-top: 28px; padding-bottom: 40px;
    border-top: 1px solid var(--line);
    font: 12px var(--mono); color: var(--muted);
  }
</style>
